# Environment Variables Sample
# Copy this file to .env.local and fill in your actual values
# .env.local is already in .gitignore and will not be committed

# ============================================
# Database Configuration (Required)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password_here

# ============================================
# Connection Pool Settings (Optional)
# ============================================
# DB_POOL_SIZE=10
# DB_POOL_MIN_IDLE=5
# DB_CONNECTION_TIMEOUT=30000
# DB_IDLE_TIMEOUT=600000
# DB_MAX_LIFETIME=1800000

# ============================================
# JPA/Hibernate Settings (Optional)
# ============================================
# JPA_DDL_AUTO=validate
# JPA_SHOW_SQL=false
# JPA_FORMAT_SQL=false
# JPA_USE_SQL_COMMENTS=false

# ============================================
# Flyway Migration Settings (Optional)
# ============================================
# FLYWAY_ENABLED=true
# FLYWAY_BASELINE_ON_MIGRATE=false

# ============================================
# Spring Profile (Optional)
# ============================================
# SPRING_PROFILES_ACTIVE=local
# Options: local, sandbox

# ============================================
# Supabase Connection Example
# ============================================
# For Supabase, use the connection details from your Supabase dashboard:
# DB_HOST=db.xxxxx.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.xxxxx
# DB_PASSWORD=your_supabase_password

# ============================================
# Local Development Example
# ============================================
# For local PostgreSQL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=trading_db
# DB_USER=postgres
# DB_PASSWORD=postgres

